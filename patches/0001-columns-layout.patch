@@ -157,6 +157,20 @@
     column(area.x, master_width, masters);
     column(split ? area.x + master_width + gap : area.x,
            split ? area.width - master_width - gap : area.width, stack_count);
+    return rectangles;
+}
+
+inline std::vector<Rect> columns(Rect area, int count, double, int gap, int = 1) {
+    if (count <= 0) return {};
+    gap = std::clamp(gap, 0, std::max(0, std::min((area.width-count)/(count+1), (area.height-1)/2)));
+    const int usable = std::max(count, area.width - gap * (count + 1));
+    std::vector<Rect> rectangles;
+    rectangles.reserve(count);
+    for (int index=0; index<count; ++index) {
+        const int left=usable*index/count, right=usable*(index+1)/count;
+        rectangles.push_back({area.x+gap*(index+1)+left, area.y+gap,
+                              std::max(1,right-left), std::max(1,area.height-2*gap)});
+    }
     return rectangles;
 }
 
